# --- mistake-finder voice agent -------------------------------
# Copy to .env and fill in.  .env is gitignored; this example is safe to commit.

# IBM Cloud API key (IAM).  Create one at https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=

# Watson Speech to Text instance
IBM_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com/instances/<your-stt-instance-id>
IBM_STT_MODEL=en-US_BroadbandModel

# Watson Text to Speech instance
IBM_TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com/instances/<your-tts-instance-id>
IBM_TTS_VOICE=en-US_AllisonV3Voice

# watsonx.ai (Granite) - used only for free-form questions
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=<your-watsonx-project-id>
WATSONX_MODEL=ibm/granite-4-h-small

# Microphone (run:  voice.bat --list-mics  to see the exact names)
# Leave blank to auto-pick the first audio input device.
VOICE_MIC=

# Max seconds to record before it stops on its own
VOICE_MAX_SECONDS=15

# Path to a DirectShow-capable ffmpeg. Blank = auto-discover.
FFMPEG=
